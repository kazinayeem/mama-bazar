# =============================================================================
# Mama Bazar Backend - Environment Configuration (.env)
# =============================================================================

# Server Port (cPanel will assign automatically via Passenger, or uses 5000)
PORT=5000
NODE_ENV=production

# Frontend URL (Your store domain or React/Next.js URL)
FRONTEND_URL=https://your-frontend-domain.com

# JWT Secret Key (Required for admin and user authentication)
JWT_SECRET=replace_with_a_secure_random_string_minimum_32_characters

# Local Uploads directory (relative to backend root)
UPLOAD_DIR=uploads

# =============================================================================
# Database Configuration (Choose OPTION A or OPTION B)
# =============================================================================

# --- OPTION A: Single URL (Recommended for TiDB, AWS RDS, or standard MySQL) ---
# For Remote TiDB / Cloud with SSL:
DATABASE_URL="mysql://2KaRM2SsQY5Vxer.root:3i2AjUn1QRUr3XXf@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/fortune500"

# For cPanel Localhost MySQL (Without SSL):
# DATABASE_URL="mysql://cpaneluser_dbuser:YourPassword123@localhost:3306/cpaneluser_dbname"

# --- OPTION B: Separate Variables (Convenient for cPanel MySQL) ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=cpaneluser_dbuser
# DB_PASSWORD=YourPassword123
# DB_NAME=cpaneluser_dbname
# DATABASE_SSL=false

# =============================================================================
# Cloudinary (Optional — if not set, files are saved locally in UPLOAD_DIR)
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# Analytics & Tracking (Optional)
# =============================================================================
FACEBOOK_PIXEL_ID=
FACEBOOK_ACCESS_TOKEN=
