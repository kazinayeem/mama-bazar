APP_NAME="Mama Bazar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL for cPanel deployment)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mama_bazar
DB_USERNAME=root
DB_PASSWORD=
# On cPanel shared hosting:
# DB_HOST=localhost
# DB_DATABASE=yourcpaneluser_mamabazar
# DB_USERNAME=yourcpaneluser_dbuser
# DB_PASSWORD=your_database_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@mamabazar.com"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000
JWT_SECRET=
AI_CHAT_URL=http://13.204.75.195:3000/chat

# Seeded Admin Account Credentials
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PHONE="01700000000"
ADMIN_PASSWORD="ChangeMe123!"

VITE_APP_NAME="${APP_NAME}"

# Reverse Proxy Configuration (comma-separated IPs/CIDRs, or * behind trusted load balancer)
# TRUSTED_PROXIES=

# Geolocation Configuration
GEOLOCATION_ENABLED=true
GEOLOCATION_DRIVER=ip-api
GEOLOCATION_API_KEY=
GEOLOCATION_ENDPOINT=
GEOLOCATION_CACHE_TTL=86400
GEOLOCATION_TIMEOUT=3
