# Frontend environment configuration
# ---------------------------------
# Point this at your backend API origin. In production the API is typically
# served from the SAME origin as the frontend (e.g. Vercel routing /api/* and
# /uploads/* to the backend function), in which case leave VITE_API_URL EMPTY.
#
# Development (backend running locally on port 5000):
VITE_API_URL=http://localhost:5000
# Staging (separate API origin):






#VITE_API_URL=https://api.staging.mamabazar.com
# Production (same-origin — leave empty):
# VITE_API_URL=
